# Supabase Database Connection
# Copy this file to .env and fill in your Supabase project credentials.
# Find these in: Supabase Dashboard > Project Settings > Database

# Host: db.<your-project-ref>.supabase.co
SUPABASE_DB_HOST=db.your-project-ref.supabase.co

# Default Supabase port (5432 for direct, 6543 for connection pooler/pgBouncer)
SUPABASE_DB_PORT=5432

# Default Supabase database name
SUPABASE_DB_NAME=postgres

# Default Supabase user
SUPABASE_DB_USER=postgres

# Your Supabase database password (set when creating the project)
SUPABASE_DB_PASSWORD=your-database-password
